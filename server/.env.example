# Copy this file to .env and fill in real values.
# .env is gitignored.

# Required for AI-generated welcome messages on /health.
# If unset, /health returns a static fallback string.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional — defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional — defaults to 3000 / 0.0.0.0.
PORT=3000
HOST=0.0.0.0
